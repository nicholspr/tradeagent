# ---- eToro (Settings > Trading > API Key Management; choose Real + Write) ----
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_ENV=real            # real or demo (must match the key's environment)
DRY_RUN=false             # true = go through every step but never send orders

# ---- Claude for the research agents (console.anthropic.com) ----
ANTHROPIC_API_KEY=
TA_DEEP_MODEL=claude-sonnet-5
TA_QUICK_MODEL=claude-sonnet-5
FRED_API_KEY=             # optional, free: fred.stlouisfed.org (macro data)
SEC_EDGAR_USER_AGENT=     # optional: "Your Name your@email" for US filings

# ---- Twilio SMS ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=              # your Twilio number, e.g. +447700900123
ALERT_SMS_TO=             # your mobile, e.g. +447700900456

# ---- Gmail (needs 2-step verification + an App Password) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=

# ---- App ----
PUBLIC_BASE_URL=https://nichsoft.io/trader
APP_SECRET=               # long random string; signs approval links
